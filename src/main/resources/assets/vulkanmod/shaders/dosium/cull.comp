#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct SectionData {
    vec4 minBounds; // xyz = minPos, w = indexCount
    vec4 maxBounds; // xyz = maxPos, w = firstIndex
    ivec4 offsets;  // x = vertexOffset, y = flags, z = chunkAreaIndex, w = sectionIndex
};

struct DrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

layout(std430, set = 0, binding = 0) readonly buffer SectionBuffer {
    SectionData sections[];
};

layout(std430, set = 0, binding = 1) writeonly buffer IndirectCommandBuffer {
    DrawIndexedIndirectCommand commands[];
};

layout(std430, set = 0, binding = 2) buffer DrawCountBuffer {
    uint drawCount;
};

layout(set = 0, binding = 3) uniform sampler2D u_HiZPyramid;

layout(push_constant) uniform CullPushConstants {
    mat4 viewProj;
    vec4 frustumPlanes[6];
    vec4 cameraPosAndMode; // xyz = cameraPos, w = mode (1.0 = Frustum only, 2.0 = Frustum + Hi-Z)
    uvec4 countsAndScreen; // x = totalSections, y = width, z = height, w = maxMip
} pc;

bool frustumCull(vec3 bmin, vec3 bmax) {
    for (int i = 0; i < 6; ++i) {
        vec4 plane = pc.frustumPlanes[i];
        vec3 p = vec3(
            plane.x >= 0.0 ? bmax.x : bmin.x,
            plane.y >= 0.0 ? bmax.y : bmin.y,
            plane.z >= 0.0 ? bmax.z : bmin.z
        );
        if (dot(plane.xyz, p) + plane.w < 0.0) {
            return false;
        }
    }
    return true;
}

bool hizOcclusionCull(vec3 bmin, vec3 bmax) {
    if (pc.cameraPosAndMode.w < 1.5) {
        return true;
    }

    vec3 corners[8] = vec3[8](
        vec3(bmin.x, bmin.y, bmin.z),
        vec3(bmax.x, bmin.y, bmin.z),
        vec3(bmin.x, bmax.y, bmin.z),
        vec3(bmax.x, bmax.y, bmin.z),
        vec3(bmin.x, bmin.y, bmax.z),
        vec3(bmax.x, bmin.y, bmax.z),
        vec3(bmin.x, bmax.y, bmax.z),
        vec3(bmax.x, bmax.y, bmax.z)
    );

    vec2 uvMin = vec2(1.0);
    vec2 uvMax = vec2(0.0);
    float minDepth = 1.0;

    for (int i = 0; i < 8; ++i) {
        vec4 clip = pc.viewProj * vec4(corners[i], 1.0);
        if (clip.w <= 0.001) {
            return true;
        }
        vec3 ndc = clip.xyz / clip.w;
        vec2 uv = clamp(ndc.xy * 0.5 + 0.5, 0.0, 1.0);
        uvMin = min(uvMin, uv);
        uvMax = max(uvMax, uv);
        minDepth = min(minDepth, clamp(ndc.z, 0.0, 1.0));
    }

    vec2 rectSize = (uvMax - uvMin) * vec2(float(pc.countsAndScreen.y), float(pc.countsAndScreen.z));
    float maxDim = max(rectSize.x, rectSize.y);
    float mip = clamp(ceil(log2(max(maxDim, 1.0))), 0.0, float(pc.countsAndScreen.w));

    float d0 = textureLod(u_HiZPyramid, uvMin, mip).r;
    float d1 = textureLod(u_HiZPyramid, vec2(uvMax.x, uvMin.y), mip).r;
    float d2 = textureLod(u_HiZPyramid, vec2(uvMin.x, uvMax.y), mip).r;
    float d3 = textureLod(u_HiZPyramid, uvMax, mip).r;
    float maxOccluderDepth = max(max(d0, d1), max(d2, d3));

    return minDepth <= (maxOccluderDepth + 0.0005);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.countsAndScreen.x) {
        return;
    }

    SectionData sec = sections[idx];
    uint indexCount = floatBitsToUint(sec.minBounds.w);
    if (indexCount == 0u) {
        return;
    }

    vec3 bmin = sec.minBounds.xyz - pc.cameraPosAndMode.xyz;
    vec3 bmax = sec.maxBounds.xyz - pc.cameraPosAndMode.xyz;

    if (!frustumCull(bmin, bmax)) {
        return;
    }

    if (!hizOcclusionCull(bmin, bmax)) {
        return;
    }

    uint outIdx = atomicAdd(drawCount, 1u);
    DrawIndexedIndirectCommand cmd;
    cmd.indexCount = indexCount;
    cmd.instanceCount = 1u;
    cmd.firstIndex = floatBitsToUint(sec.maxBounds.w);
    cmd.vertexOffset = sec.offsets.x;
    cmd.firstInstance = 0u;
    commands[outIdx] = cmd;
}
