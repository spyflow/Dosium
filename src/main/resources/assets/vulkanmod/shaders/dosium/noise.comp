#version 450

layout(local_size_x = 4, local_size_y = 8, local_size_z = 4) in;

layout(std430, set = 0, binding = 0) writeonly buffer NoiseDensityBuffer {
    float densities[];
};

layout(push_constant) uniform NoisePushConstants {
    vec4 chunkOriginAndScale; // xyz = world origin, w = frequency
    ivec4 gridDimsAndSeed;    // xyz = grid dims, w = seed
} pc;

float hash3(ivec3 p, int seed) {
    int n = p.x * 73856093 ^ p.y * 19349663 ^ p.z * 83492791 ^ seed;
    n = (n << 13) ^ n;
    return 1.0 - float((n * (n * n * 15731 + 789221) + 1376312589) & 0x7fffffff) / 1073741824.0;
}

float valueNoise3D(vec3 pos, int seed) {
    ivec3 i = ivec3(floor(pos));
    vec3 f = fract(pos);
    vec3 u = f * f * (3.0 - 2.0 * f);

    float n000 = hash3(i + ivec3(0, 0, 0), seed);
    float n100 = hash3(i + ivec3(1, 0, 0), seed);
    float n010 = hash3(i + ivec3(0, 1, 0), seed);
    float n110 = hash3(i + ivec3(1, 1, 0), seed);
    float n001 = hash3(i + ivec3(0, 0, 1), seed);
    float n101 = hash3(i + ivec3(1, 0, 1), seed);
    float n011 = hash3(i + ivec3(0, 1, 1), seed);
    float n111 = hash3(i + ivec3(1, 1, 1), seed);

    float nx00 = mix(n000, n100, u.x);
    float nx10 = mix(n010, n110, u.x);
    float nx01 = mix(n001, n101, u.x);
    float nx11 = mix(n011, n111, u.x);

    float nxy0 = mix(nx00, nx10, u.y);
    float nxy1 = mix(nx01, nx11, u.y);

    return mix(nxy0, nxy1, u.z);
}

void main() {
    ivec3 gid = ivec3(gl_GlobalInvocationID.xyz);
    if (gid.x >= pc.gridDimsAndSeed.x || gid.y >= pc.gridDimsAndSeed.y || gid.z >= pc.gridDimsAndSeed.z) {
        return;
    }

    vec3 samplePos = (pc.chunkOriginAndScale.xyz + vec3(gid) * 4.0) * pc.chunkOriginAndScale.w;
    float density = 0.0;
    float amp = 1.0;
    float freq = 1.0;

    for (int octave = 0; octave < 4; ++octave) {
        density += valueNoise3D(samplePos * freq, pc.gridDimsAndSeed.w + octave * 1013) * amp;
        amp *= 0.5;
        freq *= 2.0;
    }

    int idx = (gid.y * pc.gridDimsAndSeed.z + gid.z) * pc.gridDimsAndSeed.x + gid.x;
    densities[idx] = density;
}
